# ============ new-api 福利站 环境变量示例 ============
# 复制为 .env 后按注释填写。必填项缺失时后端启动会直接报错并列出缺哪些。

# 后端监听端口
PORT=8080

# 数据库驱动: mysql(生产默认) / sqlite(仅本地开发, DB_DSN 为文件路径)
DB_DRIVER=mysql
# 与 new-api 共用同一个 MySQL 实例、独立 database welfare_station。
# 请先在 MySQL 中创建: CREATE DATABASE welfare_station CHARACTER SET utf8mb4;
DB_DSN=user:pass@tcp(mysql:3306)/welfare_station?charset=utf8mb4&parseTime=True&loc=Local

# new-api 根地址(内网, 例如 http://new-api:3000)。必须与 design.md §4 契约一致。
NEWAPI_BASE_URL=http://new-api:3000
# 管理员 PAT(建议在 new-api 单独创建 welfare-bot 管理员后生成, 便于审计与吊销)。
NEWAPI_ADMIN_PAT=<welfare-bot 的访问令牌>

# LinuxDO OAuth 应用凭据(https://connect.linux.do 注册)。
LINUXDO_CLIENT_ID=<client_id>
LINUXDO_CLIENT_SECRET=<client_secret>

# 福利站对外公网地址(OAuth 回调 = 该地址 + /api/oauth/linuxdo/callback; https 时 Cookie 自动带 Secure)。
WELFARE_BASE_URL=https://welfare.example.com

# JWT 会话密钥, 必须 >= 32 字符随机串。
WELFARE_JWT_SECRET=<random-32+bytes>

# 站长 LinuxDO 数字 id, 逗号分隔。白名单内用户登录后自动获得管理员角色。
WELFARE_ADMIN_LINUXDO_IDS=12345,67890

# 额度换算系数, 必须与 new-api 实例设置一致(默认 500000 = $1)。
QUOTA_PER_UNIT=500000

# 单次手动发放额度上限(防手滑)。
MAX_GRANT_QUOTA=5000000

# ===== 仅本地开发(不要用于生产) =====
# MOCK_OAUTH=true 时跳过真实 LinuxDO, 回调用 mock 用户(id 默认 10001, 可用查询参数 mock_id 覆盖)。
# MOCK_OAUTH=false
# MOCK_LINUXDO_ID=10001
# MOCK_TRUST_LEVEL=2

# 站点名(显示用, 默认"福利站")
# WELFARE_SITE_NAME=福利站